@@ -0,0 +1,59 @@
+# SPDX-License-Identifier: AGPL-3.0-or-later
+
+# Library pinpointers. Using one opens a menu of books, the one you pick is tracked like with any pinpointer.
+# Using it again switches it off. The arrow and distance come from the normal Pinpointer component, which is
+# told what to track by the BookPinpointer component, so there is no whitelist here.
+- type: entity
+  parent: PinpointerBase
+  id: BookPinpointer
+  name: book pinpointer
+  description: A handheld library tool. Use it to list the books in the room you are in, pick one and it points the way. Use it again to switch it off. It loses the book when it gets too far away.
+  components:
+  - type: Sprite
+    layers:
+    - state: pinpointer
+      map: ["enum.PinpointerLayers.Base"]
+    - state: pinonnull
+      map: ["enum.PinpointerLayers.Screen"]
+      shader: unshaded
+      visible: false
+  - type: Icon
+    state: pinpointer
+  - type: Pinpointer
+    canToggle: false
+    canTargetMultiple: false
+    updateTargetName: true
+  - type: BookPinpointer
+    maxRange: 30
+  - type: UserInterface
+    interfaces:
+      enum.BookPinpointerUiKey.Key:
+        type: BookPinpointerBoundUserInterface
+
+- type: entity
+  parent: PinpointerBase
+  id: LibrarianUniversalPinpointer
+  name: Librarian's universal pinpointer
+  description: Librarian's mightiest weapon. Track any book, find the missing or overdue books and beat the book thieves, with the books they stole.
+  components:
+  - type: Sprite
+    layers:
+    - state: pinpointer-station
+      map: ["enum.PinpointerLayers.Base"]
+    - state: pinonnull
+      map: ["enum.PinpointerLayers.Screen"]
+      shader: unshaded
+      visible: false
+  - type: Icon
+    state: pinpointer-station
+  - type: Pinpointer
+    canToggle: false
+    canTargetMultiple: false
+    updateTargetName: true
+  - type: BookPinpointer
+    universal: true
+    maxRange: 0
+  - type: UserInterface
+    interfaces:
+      enum.BookPinpointerUiKey.Key:
+        type: BookPinpointerBoundUserInterface
diff --git a/Resources/Prototypes/_Omu/Entities/Objects/Misc/library_books.yml b/Resources/Prototypes/_Omu/Entities/Objects/Misc/library_books.yml
new file mode 100644
index 000000000..77f372aae
--- /dev/null
+++ b/Resources/Prototypes/_Omu/Entities/Objects/Misc/library_books.yml
@@ -0,0 +1,145 @@
+# SPDX-License-Identifier: AGPL-3.0-or-later
+
+# Marks the guidebooks, so the library console can list them and print them from the archive.
+- type: Tag
+  id: LibraryGuidebook
+
+# A book printed from the library archive or bound by the book binder.
+# Random cover like BookRandom; the name, author and text are filled in by the library systems.
+- type: entity
+  parent: BookRandom
+  id: BookLibraryPrinted
+  suffix: library
+  components:
+  - type: LibraryBook
+  # The book sprite plus the two hidden layers the paper visualizer looks for. Books have an Appearance (for the
+  # fire visuals) and a written book would otherwise log "Layer with key 'Writing' does not exist".
+  - type: Sprite
+    sprite: Objects/Misc/books.rsi
+    layers:
+    - state: paper
+    - state: cover_base
+      color: "#332d27"
+      map: [ "cover" ]
+    - state: decor_wingette
+      color: "#453f3a"
+      map: [ "decor" ]
+    - state: icon_text
+      map: [ "icon" ]
+    - state: overlay_null
+      map: [ "overlay" ]
+    - state: overlay_null
+      visible: false
+      map: [ "enum.PaperVisualLayers.Writing" ]
+    - state: overlay_null
+      visible: false
+      map: [ "enum.PaperVisualLayers.Stamp" ]
+  # Library books burn like paper, but they are thicker and take a bit longer to turn to ash.
+  - type: Appearance
+  - type: Reactive
+    groups:
+      Flammable: [ Touch ]
+      Extinguish: [ Touch ]
+  - type: ExtinguishableSetCollisionWake
+  - type: Flammable
+    fireSpread: true
+    alwaysCombustible: true
+    canExtinguish: true
+    damage:
+      types:
+        Heat: 1
+  - type: FireVisuals
+    sprite: Effects/fire.rsi
+    normalState: fire
+  - type: Damageable
+    damageModifierSet: Wood
+  - type: Destructible
+    thresholds:
+    - trigger:
+        !type:DamageTrigger
+        damage: 100
+      behaviors:
+      - !type:DoActsBehavior
+        acts: [ "Destruction" ]
+    - trigger:
+        !type:DamageTrigger
+        damage: 25
+      behaviors:
+      - !type:SpawnEntitiesBehavior
+        spawn:
+          Ash:
+            min: 1
+            max: 1
+      - !type:DoActsBehavior
+        acts: [ "Destruction" ]
+
+# A book that turns into a random book from the library archive when the map starts. Used for the books
+# that used to be random story / premade story books on maps and in bookshelves.
+- type: entity
+  parent: BookLibraryPrinted
+  id: BookRandomArchive
+  suffix: random archive
+  components:
+  - type: RandomArchiveBook
+
+# The premade story books are copied into a brand new library archive, so there is always something to find.
+- type: librarySeed
+  id: PremadeStoryBooks
+  author: Unknown
+  category: Fiction
+  books:
+  - BookNarsieLegend
+  - BookTruth
+  - BookWorld
+  - BookIanAntarctica
+  - BookSlothClownSSS
+  - BookSlothClownPranks
+  - BookSlothClownMMD
+  - BookStruck
+  - BookSun
+  - BookPossum
+  - BookCafe
+  - BookFeather
+  - BookIanLostWolfPup
+  - BookIanRanch
+  - BookIanOcean
+  - BookIanMountain
+  - BookIanCity
+  - BookIanArctic
+  - BookIanDesert
+  - BookNames
+  - BookEarth
+  - BookAurora
+  - BookTemple
+  - BookWatched
+  - BookMedicalOfficer
+  - BookMorgue
+  - BookRufus
+  - BookMap
+  - BookJourney
+  - BookInspiration
+  - BookJanitorTale
+  texts:
+  - title: Botanical Specimens of NT
+    text: book-text-botanics
+  - title: Igor's Guide to Chemistry
+    text: book-text-chemistry-insane
+  - title: How To Summon a Demon
+    author: J.G. Wizgerald
+    text: book-text-demonomicon1
+  - title: How To Summon a Lemon
+    author: J.G. Wizgerald
+    text: book-text-demonomicon2
+  - title: Cool Demon Names I Found
+    author: Ms. Mossrock
+    text: book-text-demonomicon3
+  - title: Small Adventures, Big Station
+    text: book-text-detective
+  - title: The Art of Getting Robusted
+    text: book-text-escalation
+  - title: A Security Officer's Pen
+    text: book-text-escalation-security
+  - title: I Want To Catch Space Fish
+    text: book-text-fishing
+  - title: All Hail Our Gnome King
+    text: book-text-gnome
diff --git a/Resources/Prototypes/_Omu/Entities/Structures/Machines/library.yml b/Resources/Prototypes/_Omu/Entities/Structures/Machines/library.yml
new file mode 100644
index 000000000..9da044779
--- /dev/null
+++ b/Resources/Prototypes/_Omu/Entities/Structures/Machines/library.yml
@@ -0,0 +1,222 @@
+# SPDX-License-Identifier: AGPL-3.0-or-later
+
+- type: entity
+  parent: [ BaseComputer ]
+  id: ComputerLibrary
+  name: book inventory management console
+  description: The librarian's command station. Browse the archive, print books and keep track of what is lent out.
+  components:
+  - type: Computer
+    board: LibraryComputerCircuitboard
+  - type: Sprite
+    layers:
+    - map: ["computerLayerBody"]
+      state: computer
+    - map: ["computerLayerKeyboard"]
+      state: generic_keyboard
+    - map: ["computerLayerScreen"]
+      state: request
+    - map: ["computerLayerKeys"]
+      state: generic_keys
+    - map: [ "enum.WiresVisualLayers.MaintenancePanel" ]
+      state: generic_panel_open
+  - type: LibraryConsole
+    idSlot:
+      name: library-console-id-slot
+      insertSound: /Audio/Machines/id_insert.ogg
+      ejectSound: /Audio/Machines/id_swipe.ogg
+      whitelist:
+        components:
+        - IdCard
+        - Pda
+  - type: ItemSlots
+  - type: DeviceLinkSource
+    ports:
+    - LibraryBinder
+    - LibraryScanner
+  - type: DeviceLinkSink
+    ports:
+    - LibraryRequestInbox
+  - type: AccessReader
+    access: [ [ "Library" ], [ "Command" ] ]
+  - type: ActivatableUI
+    key: enum.LibraryConsoleUiKey.Key
+  - type: UserInterface
+    interfaces:
+      enum.LibraryConsoleUiKey.Key:
+        type: LibraryConsoleBoundUserInterface
+      enum.WiresUiKey.Key:
+        type: WiresBoundUserInterface
+
+- type: entity
+  parent: [ BaseComputer ]
+  id: ComputerLibraryRequest
+  name: book request console
+  description: A console to request books. You can have your favorite book be printed only for you or get a blank book to write your favorite fan fictions or just your daily duties.
+  components:
+  - type: Computer
+    board: LibraryRequestComputerCircuitboard
+  - type: Sprite
+    layers:
+    - map: ["computerLayerBody"]
+      state: computer
+    - map: ["computerLayerKeyboard"]
+      state: generic_keyboard
+    - map: ["computerLayerScreen"]
+      state: request
+    - map: ["computerLayerKeys"]
+      state: generic_keys
+    - map: [ "enum.WiresVisualLayers.MaintenancePanel" ]
+      state: generic_panel_open
+  - type: LibraryRequestConsole
+  - type: DeviceLinkSource
+    ports:
+    - LibraryRequests
+  - type: ActivatableUI
+    key: enum.LibraryRequestConsoleUiKey.Key
+  - type: UserInterface
+    interfaces:
+      enum.LibraryRequestConsoleUiKey.Key:
+        type: LibraryRequestConsoleBoundUserInterface
+      enum.WiresUiKey.Key:
+        type: WiresBoundUserInterface
+
+- type: entity
+  parent: [ BaseMachinePowered, ConstructibleMachine ]
+  id: LibraryScanner
+  name: book scanner
+  description: An industrial strength book scanner. Scan a book here, then upload it to the archive from a library console.
+  components:
+  - type: Sprite
+    sprite: Structures/Machines/fax_machine.rsi
+    drawdepth: SmallObjects
+    layers:
+    - state: icon
+      map: [ "enum.PowerDeviceVisuals.Powered" ]
+  - type: Appearance
+  - type: GenericVisualizer
+    visuals:
+      enum.PowerDeviceVisuals.Powered:
+        enum.PowerDeviceVisuals.Powered:
+          True: { state: idle }
+          False: { state: icon }
+  - type: Machine
+    board: LibraryScannerMachineCircuitboard
+  - type: ApcPowerReceiver
+    powerLoad: 250
+  - type: LibraryScanner
+    bookSlot:
+      name: library-scanner-book-slot
+      insertSound: /Audio/Machines/scanning.ogg
+      ejectSound: /Audio/Machines/tray_eject.ogg
+      whitelist:
+        components:
+        - Paper
+        tags:
+        - Book
+  - type: ItemSlots
+  - type: DeviceLinkSink
+    ports:
+    - LibraryConsole
+  - type: AccessReader
+    access: [ [ "Library" ], [ "Command" ] ]
+  - type: ContainerContainer
+    containers:
+      machine_board: !type:Container
+      machine_parts: !type:Container
+  - type: ActivatableUI
+    key: enum.LibraryScannerUiKey.Key
+  - type: ActivatableUIRequiresPower
+  - type: UserInterface
+    interfaces:
+      enum.LibraryScannerUiKey.Key:
+        type: LibraryScannerBoundUserInterface
+
+- type: entity
+  parent: [ BaseMachinePowered, ConstructibleMachine ]
+  id: Bookbinder
+  name: book binder
+  description: Only intended for binding paper products. Feed it sheets of paper, swipe an ID to be credited as the author, then give it a written sheet of paper. Also prints the books a library console asks for.
+  components:
+  - type: Sprite
+    sprite: Structures/Machines/uniform_printer.rsi
+    layers:
+    - state: icon
+  - type: Machine
+    board: BookbinderMachineCircuitboard
+  - type: ApcPowerReceiver
+    powerLoad: 400
+  - type: Bookbinder
+    startingSheets: 30
+  - type: DeviceLinkSink
+    ports:
+    - LibraryConsole
+  - type: MaterialStorage
+    storageLimit: 9000 # 90 sheets of paper
+    materialWhiteList:
+    - Paper
+    whitelist:
+      tags:
+      - Sheet
+  - type: AccessReader
+    access: [ [ "Library" ], [ "Command" ] ]
+  - type: ContainerContainer
+    containers:
+      machine_board: !type:Container
+      machine_parts: !type:Container
+      bookbinder_paper: !type:ContainerSlot
+
+# What a built book binder is, it starts without paper unlike the ones that spawn.
+- type: entity
+  parent: Bookbinder
+  id: BookbinderBuilt
+  suffix: Built
+  categories: [ HideSpawnMenu ]
+  components:
+  - type: Bookbinder
+    startingSheets: 0
+
+# Circuit boards
+- type: entity
+  parent: BaseComputerCircuitboard
+  id: LibraryComputerCircuitboard
+  name: book inventory management console board
+  description: A computer printed circuit board for a library console.
+  components:
+  - type: Sprite
+    state: cpu_service
+  - type: ComputerBoard
+    prototype: ComputerLibrary
+
+- type: entity
+  parent: BaseComputerCircuitboard
+  id: LibraryRequestComputerCircuitboard
+  name: book request console board
+  description: A computer printed circuit board for a book request console.
+  components:
+  - type: Sprite
+    state: cpu_service
+  - type: ComputerBoard
+    prototype: ComputerLibraryRequest
+
+- type: entity
+  parent: BaseMachineCircuitboard
+  id: LibraryScannerMachineCircuitboard
+  name: book scanner machine board
+  components:
+  - type: MachineBoard
+    prototype: LibraryScanner
+    stackRequirements:
+      Manipulator: 2
+      Glass: 1
+
+- type: entity
+  parent: BaseMachineCircuitboard
+  id: BookbinderMachineCircuitboard
+  name: book binder machine board
+  components:
+  - type: MachineBoard
+    prototype: BookbinderBuilt
+    stackRequirements:
+      Manipulator: 2
+      Glass: 1
