+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+using Content.Omu.Shared.Library;
+using Content.Shared.Access.Systems;
+using Content.Shared.DeviceLinking;
+using Content.Shared.DeviceLinking.Events;
+using Content.Shared.Popups;
+using Content.Shared.Power.EntitySystems;
+using Content.Shared.UserInterface;
+using Robust.Server.GameObjects;
+using Robust.Shared.Timing;
+
+namespace Content.Omu.Server.Library;
+
+/// <summary>
+///     The book request console: people look through the archive or ask for a blank book, and the request goes
+///     to the library console it is linked to. The librarian accepts or denies it there.
+/// </summary>
+public sealed class LibraryRequestSystem : EntitySystem
+{
+    [Dependency] private readonly IGameTiming _timing = default!;
+    [Dependency] private readonly LibraryArchiveSystem _archive = default!;
+    [Dependency] private readonly LibraryConsoleSystem _consoles = default!;
+    [Dependency] private readonly SharedDeviceLinkSystem _deviceLink = default!;
+    [Dependency] private readonly SharedIdCardSystem _idCard = default!;
+    [Dependency] private readonly SharedPopupSystem _popup = default!;
+    [Dependency] private readonly SharedPowerReceiverSystem _power = default!;
+    [Dependency] private readonly UserInterfaceSystem _ui = default!;
+
+    public override void Initialize()
+    {
+        base.Initialize();
+
+        SubscribeLocalEvent<LibraryRequestConsoleComponent, NewLinkEvent>(OnLinkChanged);
+        SubscribeLocalEvent<LibraryRequestConsoleComponent, PortDisconnectedEvent>(OnLinkRemoved);
+        SubscribeLocalEvent<LibraryRequestConsoleComponent, AfterActivatableUIOpenEvent>(OnUiOpened);
+        SubscribeLocalEvent<LibraryRequestConsoleComponent, LibraryRequestSearchMessage>(OnSearch);
+        SubscribeLocalEvent<LibraryRequestConsoleComponent, LibraryRequestArchiveMessage>(OnRequestArchive);
+        SubscribeLocalEvent<LibraryRequestConsoleComponent, LibraryRequestBlankMessage>(OnRequestBlank);
+
+        _archive.ArchiveChanged += OnArchiveChanged;
+    }
+
+    public override void Shutdown()
+    {
+        base.Shutdown();
+
+        _archive.ArchiveChanged -= OnArchiveChanged;
+    }
+
+    private void OnArchiveChanged()
+    {
+        var query = EntityQueryEnumerator<LibraryRequestConsoleComponent>();
+        while (query.MoveNext(out var uid, out var component))
+        {
+            UpdateUi(uid, component);
+        }
+    }
+
+    private void OnLinkChanged(EntityUid uid, LibraryRequestConsoleComponent component, NewLinkEvent args)
+    {
+        UpdateUi(uid, component);
+    }
+
+    private void OnLinkRemoved(EntityUid uid, LibraryRequestConsoleComponent component, PortDisconnectedEvent args)
+    {
+        UpdateUi(uid, component);
+    }
+
+    private void OnUiOpened(EntityUid uid, LibraryRequestConsoleComponent component, AfterActivatableUIOpenEvent args)
+    {
+        UpdateUi(uid, component);
+    }
+
+    /// <summary>
+    ///     The library console that was linked to this console's "requests" port with a network configurator.
+    /// </summary>
+    private bool TryGetLibraryConsole(EntityUid uid, out Entity<LibraryConsoleComponent> console)
+    {
+        if (TryComp<DeviceLinkSourceComponent>(uid, out var source))
+        {
+            foreach (var sink in _deviceLink.GetLinkedSinks((uid, source), LibraryConstants.RequestSourcePort))
+            {
+                if (TryComp<LibraryConsoleComponent>(sink, out var comp))
+                {
+                    console = (sink, comp);
+                    return true;
+                }
+            }
+        }
+
+        console = default;
+        return false;
+    }
+
+    private void OnSearch(EntityUid uid, LibraryRequestConsoleComponent component, LibraryRequestSearchMessage args)
+    {
+        if (!_power.IsPowered(uid) || _timing.CurTime < component.NextSearchTime)
+            return;
+
+        component.NextSearchTime = _timing.CurTime + component.SearchCooldown;
+        component.SearchTitle = LibraryText.CleanLine(args.Title, LibraryConstants.MaxTitleLength);
+        component.SearchAuthor = LibraryText.CleanLine(args.Author, LibraryConstants.MaxAuthorLength);
+        component.SearchPage = Math.Max(args.Page, 0);
+
+        UpdateUi(uid, component);
+    }
+
+    private void OnRequestArchive(EntityUid uid, LibraryRequestConsoleComponent component, LibraryRequestArchiveMessage args)
+    {
+        if (!TryStartRequest(uid, component, out var console))
+            return;
+
+        // Only books that are in the archive (not under review, not deleted) can be asked for.
+        if (!_archive.TryGet(args.Id, out var entry) || entry.Pending)
+        {
+            Say(uid, "library-request-unknown-book");
+            return;
+        }
+
+        var request = new LibraryBookRequest
+        {
+            Kind = LibraryRequestKind.Archive,
+            ArchiveId = entry.Id,
+            Title = LibraryText.CleanLine(entry.Title, LibraryConstants.MaxTitleLength),
+            Author = LibraryText.CleanLine(entry.Author, LibraryConstants.MaxAuthorLength),
+            Cover = LibraryCovers.Default(entry.Id),
+            Requester = RequesterName(args.Actor),
+            RequesterCard = FindCard(args.Actor),
+            Source = uid,
+        };
+
+        Send(uid, component, console, request);
+    }
+
+    private void OnRequestBlank(EntityUid uid, LibraryRequestConsoleComponent component, LibraryRequestBlankMessage args)
+    {
+        if (!TryStartRequest(uid, component, out var console))
+            return;
+
+        var title = LibraryText.CleanLine(args.Title, LibraryConstants.MaxTitleLength);
+        if (title.Length == 0)
+        {
+            Say(uid, "library-request-no-title");
+            return;
+        }
+
+        var request = new LibraryBookRequest
+        {
+            Kind = LibraryRequestKind.Blank,
+            Title = title,
+            Cover = LibraryCovers.Sanitize(args.Cover),
+            Requester = RequesterName(args.Actor),
+            RequesterCard = FindCard(args.Actor),
+            Source = uid,
+        };
+
+        Send(uid, component, console, request);
+    }
+
+    private bool TryStartRequest(
+        EntityUid uid,
+        LibraryRequestConsoleComponent component,
+        out Entity<LibraryConsoleComponent> console)
+    {
+        console = default;
+
+        if (!_power.IsPowered(uid))
+            return false;
+
+        if (_timing.CurTime < component.NextRequestTime)
+        {
+            Say(uid, "library-request-cooldown");
+            return false;
+        }
+
+        if (!TryGetLibraryConsole(uid, out console))
+        {
+            Say(uid, "library-request-no-console");
+            return false;
+        }
+
+        return true;
+    }
+
+    private void Send(
+        EntityUid uid,
+        LibraryRequestConsoleComponent component,
+        Entity<LibraryConsoleComponent> console,
+        LibraryBookRequest request)
+    {
+        if (!_consoles.TryAddRequest(console.Owner, console.Comp, request, out var failure))
+        {
+            Say(uid, failure);
+            return;
+        }
+
+        component.NextRequestTime = _timing.CurTime + component.RequestCooldown;
+        Say(uid, "library-request-sent");
+        UpdateUi(uid, component);
+    }
+
+    private EntityUid? FindCard(EntityUid actor)
+    {
+        return _idCard.TryFindIdCard(actor, out var card) ? card.Owner : null;
+    }
+
+    private string RequesterName(EntityUid actor)
+    {
+        return LibraryText.CleanLine(Name(actor), LibraryConstants.MaxBorrowerLength);
+    }
+
+    private void Say(EntityUid uid, string locId)
+    {
+        _popup.PopupEntity(Loc.GetString(locId), uid);
+    }
+
+    private void UpdateUi(EntityUid uid, LibraryRequestConsoleComponent component)
+    {
+        var linked = TryGetLibraryConsole(uid, out var console);
+
+        var results = _archive.Search(
+            component.SearchTitle,
+            component.SearchAuthor,
+            LibraryConstants.AnyCategory,
+            null,
+            ref component.SearchPage,
+            out var pageCount);
+
+        _ui.SetUiState(uid, LibraryRequestConsoleUiKey.Key, new LibraryRequestConsoleBoundUserInterfaceState(
+            linked,
+            _archive.Available,
+            component.SearchTitle,
+            component.SearchAuthor,
+            component.SearchPage,
+            pageCount,
+            results));
+    }
+}
diff --git a/Content.Omu.Server/Library/LibraryRoomSystem.cs b/Content.Omu.Server/Library/LibraryRoomSystem.cs
new file mode 100644
index 000000000..95d98631e
--- /dev/null
+++ b/Content.Omu.Server/Library/LibraryRoomSystem.cs
@@ -0,0 +1,222 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+using Content.Omu.Server.Entities.Heretic;
+using Content.Omu.Shared.Library;
+using Content.Server.Atmos.Components;
+using Content.Shared.Atmos;
+using Content.Shared.Mobs.Components;
+using Content.Shared.Paper;
+using Content.Shared.Tag;
+using Robust.Shared.Containers;
+using Robust.Shared.Map.Components;
+using Robust.Shared.Prototypes;
+
+namespace Content.Omu.Server.Library;
+
+/// <summary>
+///     Finds library books for the console and the book pinpointers: the books of the room somebody or something
+///     stands in, or every book on the station.
+/// </summary>
+public sealed class LibraryRoomSystem : EntitySystem
+{
+    [Dependency] private readonly EntityLookupSystem _lookup = default!;
+    [Dependency] private readonly IPrototypeManager _proto = default!;
+    [Dependency] private readonly SharedContainerSystem _container = default!;
+    [Dependency] private readonly SharedMapSystem _map = default!;
+    [Dependency] private readonly SharedTransformSystem _transform = default!;
+    [Dependency] private readonly TagSystem _tag = default!;
+
+    private static readonly ProtoId<TagPrototype> BookTag = "Book";
+    private static readonly ProtoId<TagPrototype> GuidebookTag = "LibraryGuidebook";
+    private const string GuidebookParent = "BaseGuidebook";
+
+    /// <summary>
+    ///     Paper books and guidebooks count as library books. Heretic tomes are not library books, even though
+    ///     they are books too.
+    /// </summary>
+    public bool IsLibraryBook(EntityUid uid)
+    {
+        if (!_tag.HasTag(uid, BookTag) || HasComp<HereticTomeComponent>(uid))
+            return false;
+
+        return HasComp<PaperComponent>(uid) || IsGuidebook(uid);
+    }
+
+    public bool IsGuidebook(EntityUid uid)
+    {
+        if (_tag.HasTag(uid, GuidebookTag))
+            return true;
+
+        if (MetaData(uid).EntityPrototype is not { } proto)
+            return false;
+
+        if (proto.ID == GuidebookParent)
+            return true;
+
+        foreach (var parent in _proto.EnumerateParents<EntityPrototype>(proto.ID) ?? [])
+        {
+            if (parent.ID == GuidebookParent)
+                return true;
+        }
+
+        return false;
+    }
+
+    /// <summary>
+    ///     Books in somebody's hands or bag.
+    /// </summary>
+    public bool IsCarried(EntityUid book)
+    {
+        var current = book;
+        while (_container.TryGetContainingContainer(current, out var container))
+        {
+            current = container.Owner;
+            if (HasComp<MobStateComponent>(current))
+                return true;
+        }
+
+        return false;
+    }
+
+    /// <summary>
+    ///     The library books lying in the room of <paramref name="origin"/>: loose books, and the books inside
+    ///     shelves, crates and lockers, which are found by walking the containers of what lies in the room.
+    ///     Books somebody carries are left out, unless <paramref name="includeCarried"/> is set.
+    /// </summary>
+    public List<EntityUid> FindRoomBooks(EntityUid origin, bool includeCarried = false)
+    {
+        var seen = new HashSet<EntityUid>();
+        var books = new List<EntityUid>();
+        var stack = new Stack<EntityUid>(GetRoomEntities(origin));
+
+        while (stack.Count > 0)
+        {
+            var current = stack.Pop();
+            if (!seen.Add(current))
+                continue;
+
+            if (IsLibraryBook(current) && (includeCarried || !IsCarried(current)))
+                books.Add(current);
+
+            if (!HasComp<ContainerManagerComponent>(current))
+                continue;
+
+            foreach (var container in _container.GetAllContainers(current))
+            {
+                foreach (var contained in container.ContainedEntities)
+                {
+                    stack.Push(contained);
+                }
+            }
+        }
+
+        return books;
+    }
+
+    /// <summary>
+    ///     Every library book on the same grid (the station) as <paramref name="origin"/>, wherever it is, even
+    ///     in somebody's hands or in a locker.
+    /// </summary>
+    public List<EntityUid> FindStationBooks(EntityUid origin)
+    {
+        var books = new List<EntityUid>();
+        var grid = Transform(origin).GridUid;
+        var map = Transform(origin).MapID;
+
+        var query = EntityQueryEnumerator<TagComponent, TransformComponent>();
+        while (query.MoveNext(out var uid, out _, out var xform))
+        {
+            if (grid != null ? xform.GridUid != grid : xform.MapID != map)
+                continue;
+
+            if (IsLibraryBook(uid))
+                books.Add(uid);
+        }
+
+        return books;
+    }
+
+    /// <summary>
+    ///     Everything lying in the room <paramref name="origin"/> is in. The room is found by spreading out over the
+    ///     floor from there, like air does: walls, full-tile windows and airlocks stop it, directional windows and
+    ///     windoors do not. So a console sees the books of its own library and not those of the room behind a wall.
+    /// </summary>
+    public List<EntityUid> GetRoomEntities(EntityUid origin)
+    {
+        var result = new List<EntityUid>();
+        var xform = Transform(origin);
+        if (xform.GridUid is not { } gridUid || !TryComp<MapGridComponent>(gridUid, out var grid))
+            return result;
+
+        // Contained things (a pinpointer in a hand) are placed by where their holder stands.
+        var start = _map.TileIndicesFor(gridUid, grid, _transform.GetMoverCoordinates(origin, xform));
+        var visited = new HashSet<Vector2i> { start };
+        var queue = new Queue<Vector2i>();
+        queue.Enqueue(start);
+
+        var onTile = new HashSet<EntityUid>();
+        Span<Vector2i> steps = [new(1, 0), new(-1, 0), new(0, 1), new(0, -1)];
+
+        while (queue.Count > 0)
+        {
+            var tile = queue.Dequeue();
+
+            // Open space has no floor, a room ends there.
+            if (!_map.TryGetTileRef(gridUid, grid, tile, out var tileRef) || tileRef.Tile.IsEmpty)
+                continue;
+
+            onTile.Clear();
+            _lookup.GetLocalEntitiesIntersecting(
+                gridUid,
+                tile,
+                onTile,
+                -0.05f,
+                LookupFlags.Static | LookupFlags.Dynamic | LookupFlags.Sundries);
+
+            var blocked = false;
+            foreach (var entity in onTile)
+            {
+                if (BlocksRoom(entity))
+                {
+                    blocked = true;
+                    break;
+                }
+            }
+
+            // The blocking tile is the wall of the room, what is on it does not belong to the room.
+            if (blocked)
+                continue;
+
+            result.AddRange(onTile);
+
+            foreach (var step in steps)
+            {
+                var next = tile + step;
+
+                if (Math.Abs(next.X - start.X) > LibraryConstants.InventoryRadius ||
+                    Math.Abs(next.Y - start.Y) > LibraryConstants.InventoryRadius ||
+                    visited.Count >= LibraryConstants.MaxInventoryTiles ||
+                    !visited.Add(next))
+                {
+                    continue;
+                }
+
+                queue.Enqueue(next);
+            }
+        }
+
+        return result;
+    }
+
+    /// <summary>
+    ///     Whether an entity closes off the room it stands in. It must block air in every direction, like walls,
+    ///     full-tile windows and airlocks (an open airlock too, a door in the doorway still ends the room).
+    ///     Directional windows and windoors only block some directions, so they do not count.
+    /// </summary>
+    private bool BlocksRoom(EntityUid entity)
+    {
+        return TryComp<AirtightComponent>(entity, out var airtight) &&
+               Transform(entity).Anchored &&
+               airtight.InitialAirBlockedDirection == (int) AtmosDirection.All;
+    }
+}
diff --git a/Content.Omu.Server/Library/LibraryScannerSystem.cs b/Content.Omu.Server/Library/LibraryScannerSystem.cs
new file mode 100644
index 000000000..2e8de4669
--- /dev/null
+++ b/Content.Omu.Server/Library/LibraryScannerSystem.cs
@@ -0,0 +1,217 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+using Content.Omu.Shared.Library;
+using Content.Shared.Containers.ItemSlots;
+using Content.Shared.Paper;
+using Content.Shared.Popups;
+using Content.Shared.Power.EntitySystems;
+using Content.Shared.UserInterface;
+using Robust.Server.GameObjects;
+using Robust.Shared.Audio.Systems;
+using Robust.Shared.Containers;
+
+namespace Content.Omu.Server.Library;
+
+/// <summary>
+///     The library scanner: put a book in, scan it, and the console can upload the digital copy to the archive.
+///     Ported from tgstation's /obj/machinery/libraryscanner.
+/// </summary>
+public sealed class LibraryScannerSystem : EntitySystem
+{
+    [Dependency] private readonly ItemSlotsSystem _itemSlots = default!;
+    [Dependency] private readonly SharedAudioSystem _audio = default!;
+    [Dependency] private readonly SharedPopupSystem _popup = default!;
+    [Dependency] private readonly SharedPowerReceiverSystem _power = default!;
+    [Dependency] private readonly LibraryAccessSystem _libraryAccess = default!;
+    [Dependency] private readonly UserInterfaceSystem _ui = default!;
+
+    public override void Initialize()
+    {
+        base.Initialize();
+
+        SubscribeLocalEvent<LibraryScannerComponent, ComponentInit>(OnInit);
+        SubscribeLocalEvent<LibraryScannerComponent, ComponentRemove>(OnRemove);
+        SubscribeLocalEvent<LibraryScannerComponent, EntInsertedIntoContainerMessage>(OnSlotChanged);
+        SubscribeLocalEvent<LibraryScannerComponent, EntRemovedFromContainerMessage>(OnSlotChanged);
+        SubscribeLocalEvent<LibraryScannerComponent, ActivatableUIOpenAttemptEvent>(OnUiOpenAttempt);
+        SubscribeLocalEvent<LibraryScannerComponent, ItemSlotInsertAttemptEvent>(OnInsertAttempt);
+        SubscribeLocalEvent<LibraryScannerComponent, ItemSlotEjectAttemptEvent>(OnEjectAttempt);
+        SubscribeLocalEvent<LibraryScannerComponent, AfterActivatableUIOpenEvent>(OnUiOpened);
+        SubscribeLocalEvent<LibraryScannerComponent, LibraryScannerScanMessage>(OnScan);
+        SubscribeLocalEvent<LibraryScannerComponent, LibraryScannerClearMessage>(OnClear);
+        SubscribeLocalEvent<LibraryScannerComponent, LibraryScannerEjectMessage>(OnEject);
+    }
+
+    private void OnInit(EntityUid uid, LibraryScannerComponent component, ComponentInit args)
+    {
+        _itemSlots.AddItemSlot(uid, LibraryScannerComponent.BookSlotId, component.BookSlot);
+    }
+
+    private void OnRemove(EntityUid uid, LibraryScannerComponent component, ComponentRemove args)
+    {
+        _itemSlots.RemoveItemSlot(uid, component.BookSlot);
+    }
+
+    private void OnSlotChanged(EntityUid uid, LibraryScannerComponent component, ContainerModifiedMessage args)
+    {
+        if (!component.Initialized || args.Container.ID != component.BookSlot.ID)
+            return;
+
+        UpdateUi(uid, component);
+        RefreshConsoles();
+    }
+
+    private void OnUiOpenAttempt(EntityUid uid, LibraryScannerComponent component, ActivatableUIOpenAttemptEvent args)
+    {
+        if (!_libraryAccess.IsAllowed(uid, args.User, args.Silent))
+            args.Cancel();
+    }
+
+    private void OnInsertAttempt(EntityUid uid, LibraryScannerComponent component, ref ItemSlotInsertAttemptEvent args)
+    {
+        if (args.User is { } user && !_libraryAccess.IsAllowed(uid, user))
+            args.Cancelled = true;
+    }
+
+    private void OnEjectAttempt(EntityUid uid, LibraryScannerComponent component, ref ItemSlotEjectAttemptEvent args)
+    {
+        if (args.User is { } user && !_libraryAccess.IsAllowed(uid, user))
+            args.Cancelled = true;
+    }
+
+    private void OnUiOpened(EntityUid uid, LibraryScannerComponent component, AfterActivatableUIOpenEvent args)
+    {
+        UpdateUi(uid, component);
+    }
+
+    private void OnScan(EntityUid uid, LibraryScannerComponent component, LibraryScannerScanMessage args)
+    {
+        if (!_power.IsPowered(uid))
+            return;
+
+        if (component.BookSlot.Item is not { } book)
+            return;
+
+        if (!TryReadBook(book, out var data, out var failure))
+        {
+            _popup.PopupEntity(Loc.GetString(failure), uid);
+            return;
+        }
+
+        if (component.Cache == data)
+        {
+            _popup.PopupEntity(Loc.GetString("library-scanner-already-cached"), uid);
+            return;
+        }
+
+        component.Cache = data;
+        _audio.PlayPvs(component.ScanSound, uid);
+        UpdateUi(uid, component);
+        RefreshConsoles();
+    }
+
+    private void OnClear(EntityUid uid, LibraryScannerComponent component, LibraryScannerClearMessage args)
+    {
+        if (component.Cache == null)
+            return;
+
+        component.Cache = null;
+        UpdateUi(uid, component);
+        RefreshConsoles();
+    }
+
+    private void OnEject(EntityUid uid, LibraryScannerComponent component, LibraryScannerEjectMessage args)
+    {
+        if (component.BookSlot.Item == null)
+            return;
+
+        _itemSlots.TryEjectToHands(uid, component.BookSlot, args.Actor, true);
+        _audio.PlayPvs(component.EjectSound, uid);
+    }
+
+    /// <summary>
+    ///     Turns a physical book into its digital copy. Fails for entities that are not books, books that
+    ///     are marked unique and blank books.
+    /// </summary>
+    public bool TryReadBook(EntityUid book, out LibraryBookData data, out string failure)
+    {
+        data = default!;
+        failure = string.Empty;
+
+        if (!TryComp<PaperComponent>(book, out var paper))
+        {
+            failure = "library-scanner-not-a-book";
+            return false;
+        }
+
+        var author = string.Empty;
+        if (TryComp<LibraryBookComponent>(book, out var info))
+        {
+            if (info.Unique)
+            {
+                failure = "library-scanner-unique";
+                return false;
+            }
+
+            author = info.Author;
+        }
+
+        var content = LibraryText.CleanContent(paper.Content, LibraryConstants.MaxContentLength);
+        if (string.IsNullOrWhiteSpace(content))
+        {
+            failure = "library-scanner-blank";
+            return false;
+        }
+
+        var title = LibraryText.CleanLine(Name(book), LibraryConstants.MaxTitleLength);
+        author = LibraryText.CleanLine(author, LibraryConstants.MaxAuthorLength);
+        data = new LibraryBookData(title, author, content);
+        return true;
+    }
+
+    /// <summary>
+    ///     Replaces the title and author of the cached book. Does nothing when nothing is cached.
+    /// </summary>
+    public void SetCacheDetails(Entity<LibraryScannerComponent> scanner, string title, string author)
+    {
+        if (scanner.Comp.Cache is not { } cache)
+            return;
+
+        scanner.Comp.Cache = cache with
+        {
+            Title = LibraryText.CleanLine(title, LibraryConstants.MaxTitleLength),
+            Author = LibraryText.CleanLine(author, LibraryConstants.MaxAuthorLength),
+        };
+
+        UpdateUi(scanner, scanner.Comp);
+    }
+
+    private void RefreshConsoles()
+    {
+        var consoles = EntityQueryEnumerator<LibraryConsoleComponent>();
+        while (consoles.MoveNext(out var uid, out _))
+        {
+            RaiseLocalEvent(uid, new LibraryConsoleRefreshEvent());
+        }
+    }
+
+    public void UpdateUi(EntityUid uid, LibraryScannerComponent component)
+    {
+        var book = component.BookSlot.Item;
+        var canScan = book != null && TryReadBook(book.Value, out _, out _);
+
+        var state = new LibraryScannerBoundUserInterfaceState(
+            book != null,
+            canScan,
+            component.Cache != null,
+            component.Cache?.Title ?? string.Empty,
+            component.Cache?.Author ?? string.Empty);
+
+        _ui.SetUiState(uid, LibraryScannerUiKey.Key, state);
+    }
+}
+
+/// <summary>
+///     Raised on library consoles when something they display (scanner contents, archive) changed.
+/// </summary>
+public sealed class LibraryConsoleRefreshEvent : EntityEventArgs;
diff --git a/Content.Omu.Server/Library/RandomArchiveBookSystem.cs b/Content.Omu.Server/Library/RandomArchiveBookSystem.cs
new file mode 100644
index 000000000..f1c691de0
--- /dev/null
+++ b/Content.Omu.Server/Library/RandomArchiveBookSystem.cs
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+using Content.Omu.Shared.Library;
+using Content.Server.RandomMetadata;
+using Content.Shared.Paper;
+using Content.Shared.Sprite;
+
+namespace Content.Omu.Server.Library;
+
+/// <summary>
+///     Fills books with <see cref="RandomArchiveBookComponent"/> with a random book from the library archive.
+/// </summary>
+public sealed class RandomArchiveBookSystem : EntitySystem
+{
+    [Dependency] private readonly LibraryArchiveSystem _archive = default!;
+    [Dependency] private readonly MetaDataSystem _meta = default!;
+    [Dependency] private readonly PaperSystem _paper = default!;
+
+    public override void Initialize()
+    {
+        base.Initialize();
+
+        // After RandomMetadataSystem, which gives the book a random blank-book name on the same event.
+        SubscribeLocalEvent<RandomArchiveBookComponent, MapInitEvent>(OnMapInit,
+            after: [typeof(RandomMetadataSystem)]);
+    }
+
+    private void OnMapInit(Entity<RandomArchiveBookComponent> ent, ref MapInitEvent args)
+    {
+        if (_archive.TryPickRandom(out var entry))
+            Fill(ent.Owner, entry);
+    }
+
+    /// <summary>
+    ///     Gives a book the title, author and text of an archive book.
+    /// </summary>
+    public void Fill(EntityUid book, LibraryArchiveEntry entry)
+    {
+        _meta.SetEntityName(book, Loc.GetString("library-printed-book-name", ("title", entry.Title)));
+
+        var info = EnsureComp<LibraryBookComponent>(book);
+        info.Author = entry.Author;
+        info.ArchiveId = entry.Id;
+        Dirty(book, info);
+
+        _paper.SetContent(book, entry.Content);
+
+        ApplyCover(book, entry.Cover ?? LibraryCovers.Default(entry.Id));
+    }
+
+    /// <summary>
+    ///     Gives a book a fixed cover instead of its random one.
+    /// </summary>
+    public void ApplyCover(EntityUid book, LibraryCover cover)
+    {
+        if (!TryComp<RandomSpriteComponent>(book, out var random))
+            return;
+
+        random.Selected["cover"] = (cover.Style, LibraryCovers.GetColor(cover.StyleColor));
+        random.Selected["decor"] = (cover.Decor, LibraryCovers.GetColor(cover.DecorColor));
+        random.Selected["icon"] = (cover.Icon, LibraryCovers.GetColor(cover.IconColor));
+        random.Selected["overlay"] = (LibraryCovers.Blank, null);
+        Dirty(book, random);
+    }
+}
