+
+/// <summary>
+///     Binds a single sheet of paper into a book, crediting the author of the ID that was scanned.
+///     Ported from tgstation's /obj/machinery/bookbinder.
+/// </summary>
+[RegisterComponent]
+public sealed partial class BookbinderComponent : Component
+{
