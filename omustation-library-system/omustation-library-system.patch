+    ///     Who wrote the book. Empty means unknown.
+    /// </summary>
+    [DataField, AutoNetworkedField]
+    public string Author = string.Empty;
+
+    /// <summary>
+    ///     Unique books can not be scanned into the archive (the tgstation "unique" book flag).
+    /// </summary>
