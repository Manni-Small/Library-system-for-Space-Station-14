+++ b/Content.Omu.Server/Library/BookPinpointerSystem.cs
@@ -0,0 +1,193 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+using System.Linq;
+using Content.Omu.Shared.Library;
+using Content.Server.Pinpointer;
+using Content.Shared.Interaction;
+using Content.Shared.Pinpointer;
+using Content.Shared.Popups;
+using Robust.Server.GameObjects;
+using Robust.Shared.Timing;
+
+namespace Content.Omu.Server.Library;
+
+/// <summary>
+///     The book pinpointers. Using one opens a menu of books (the ones in the user's room, or every book on the
+///     station for the universal one). A picked book becomes the target of the normal pinpointer, which draws the
+///     arrow. Using the pinpointer again switches it off.
+/// </summary>
+public sealed class BookPinpointerSystem : EntitySystem
+{
+    [Dependency] private readonly IGameTiming _timing = default!;
+    [Dependency] private readonly LibraryConsoleSystem _console = default!;
+    [Dependency] private readonly LibraryRoomSystem _room = default!;
+    [Dependency] private readonly PinpointerSystem _pinpointer = default!;
+    [Dependency] private readonly SharedPopupSystem _popup = default!;
+    [Dependency] private readonly SharedTransformSystem _transform = default!;
+    [Dependency] private readonly UserInterfaceSystem _ui = default!;
+
+    private static readonly TimeSpan CheckInterval = TimeSpan.FromSeconds(1);
+
+    public override void Initialize()
+    {
+        base.Initialize();
+
+        // Before the normal pinpointer, which would just switch itself on and off.
+        SubscribeLocalEvent<BookPinpointerComponent, ActivateInWorldEvent>(
+            OnActivate,
+            before: new[] { typeof(PinpointerSystem) });
+        SubscribeLocalEvent<BookPinpointerComponent, BookPinpointerSelectMessage>(OnSelect);
+    }
+
+    public override void Update(float frameTime)
+    {
+        base.Update(frameTime);
+
+        var now = _timing.CurTime;
+        var query = EntityQueryEnumerator<BookPinpointerComponent, PinpointerComponent>();
+        while (query.MoveNext(out var uid, out var book, out var pinpointer))
+        {
+            if (!pinpointer.IsActive || now < book.NextCheck)
+                continue;
+
+            book.NextCheck = now + CheckInterval;
+
+            // The tracked book was destroyed, or it is too far away: the signal is lost.
+            var target = pinpointer.Targets.FirstOrDefault();
+            if (target == default || !Exists(target) || TerminatingOrDeleted(target) || IsTooFar(uid, book, target))
+            {
+                _popup.PopupEntity(Loc.GetString("library-pinpointer-lost"), uid);
+                _pinpointer.TogglePinpointer(uid, pinpointer);
+            }
+        }
+    }
+
+    private bool IsTooFar(EntityUid uid, BookPinpointerComponent book, EntityUid target)
+    {
+        if (book.MaxRange <= 0f)
+            return false;
+
+        var from = Transform(uid);
+        var to = Transform(target);
+        if (from.MapID != to.MapID)
+            return true;
+
+        var distance = (_transform.GetWorldPosition(to) - _transform.GetWorldPosition(from)).Length();
+        return distance > book.MaxRange;
+    }
+
+    private void OnActivate(EntityUid uid, BookPinpointerComponent book, ActivateInWorldEvent args)
+    {
+        if (args.Handled || !args.Complex || !TryComp<PinpointerComponent>(uid, out var pinpointer))
+            return;
+
+        args.Handled = true;
+
+        // Using it while it tracks a book switches it off.
+        if (pinpointer.IsActive)
+        {
+            _pinpointer.TogglePinpointer(uid, pinpointer);
+            _popup.PopupEntity(Loc.GetString("library-pinpointer-off"), uid, args.User);
+            return;
+        }
+
+        var books = FindBooks(book, args.User);
+        var missing = FindMissing(book);
+        var overdue = FindOverdue(book);
+        if (books.Count == 0 && missing.Count == 0 && overdue.Count == 0)
+        {
+            _popup.PopupEntity(Loc.GetString(book.Universal
+                ? "library-pinpointer-no-books-station"
+                : "library-pinpointer-no-books-room"), uid, args.User);
+            return;
+        }
+
+        _ui.OpenUi(uid, BookPinpointerUiKey.Key, args.User);
+        _ui.SetUiState(uid, BookPinpointerUiKey.Key, BuildState(book, books, missing, overdue));
+    }
+
+    private void OnSelect(EntityUid uid, BookPinpointerComponent book, BookPinpointerSelectMessage args)
+    {
+        if (!TryGetEntity(args.Book, out var target) || !TryComp<PinpointerComponent>(uid, out var pinpointer))
+            return;
+
+        // Only a book the menu lists can be picked, found again from where the user stands now.
+        if (!FindBooks(book, args.Actor).Contains(target.Value) && !FindMissing(book).Contains(target.Value)
+            && !FindOverdue(book).Any(o => o.Book == target.Value))
+            return;
+
+        _pinpointer.SetTarget(uid, target.Value, pinpointer);
+        book.NextCheck = _timing.CurTime + CheckInterval;
+
+        if (!pinpointer.IsActive)
+            _pinpointer.TogglePinpointer(uid, pinpointer);
+
+        _popup.PopupEntity(Loc.GetString("library-pinpointer-tracking", ("title", Name(target.Value))), uid, args.Actor);
+        _ui.CloseUi(uid, BookPinpointerUiKey.Key, args.Actor);
+    }
+
+    /// <summary>
+    ///     The books the menu offers, found from where <paramref name="user"/> stands.
+    /// </summary>
+    private List<EntityUid> FindBooks(BookPinpointerComponent book, EntityUid user)
+    {
+        return book.Universal ? _room.FindStationBooks(user) : _room.FindRoomBooks(user);
+    }
+
+    /// <summary>
+    ///     The books library consoles marked as missing. Only the universal pinpointer lists them.
+    /// </summary>
+    private List<EntityUid> FindMissing(BookPinpointerComponent book)
+    {
+        return book.Universal ? _console.GetMissingBooks() : new List<EntityUid>();
+    }
+
+    private List<(EntityUid Book, string Borrower)> FindOverdue(BookPinpointerComponent book)
+    {
+        return book.Universal ? _console.GetOverdueBooks() : new List<(EntityUid, string)>();
+    }
+
+    private List<BookPinpointerEntry> MakeOverdueEntries(List<(EntityUid Book, string Borrower)> overdue)
+    {
+        return overdue
+            .OrderBy(o => Name(o.Book), StringComparer.OrdinalIgnoreCase)
+            .ThenBy(o => o.Book.Id)
+            .Take(LibraryConstants.MaxPinpointerBooks)
+            .Select(o => new BookPinpointerEntry(
+                GetNetEntity(o.Book),
+                LibraryText.CleanLine(Name(o.Book), LibraryConstants.MaxTitleLength),
+                TryComp<LibraryBookComponent>(o.Book, out var info)
+                    ? LibraryText.CleanLine(info.Author, LibraryConstants.MaxAuthorLength)
+                    : string.Empty,
+                o.Borrower))
+            .ToList();
+    }
+
+    private List<BookPinpointerEntry> MakeEntries(List<EntityUid> books)
+    {
+        return books
+            .OrderBy(b => Name(b), StringComparer.OrdinalIgnoreCase)
+            .ThenBy(b => b.Id)
+            .Take(LibraryConstants.MaxPinpointerBooks)
+            .Select(b => new BookPinpointerEntry(
+                GetNetEntity(b),
+                LibraryText.CleanLine(Name(b), LibraryConstants.MaxTitleLength),
+                TryComp<LibraryBookComponent>(b, out var info)
+                    ? LibraryText.CleanLine(info.Author, LibraryConstants.MaxAuthorLength)
+                    : string.Empty))
+            .ToList();
+    }
+
+    private BookPinpointerBoundUserInterfaceState BuildState(
+        BookPinpointerComponent book,
+        List<EntityUid> books,
+        List<EntityUid> missing,
+        List<(EntityUid Book, string Borrower)> overdue)
+    {
+        return new BookPinpointerBoundUserInterfaceState(
+            MakeEntries(books),
+            MakeEntries(missing),
+            MakeOverdueEntries(overdue),
+            book.Universal);
+    }
+}
diff --git a/Content.Omu.Server/Library/BookbinderSystem.cs b/Content.Omu.Server/Library/BookbinderSystem.cs
new file mode 100644
index 000000000..3e0753fed
--- /dev/null
+++ b/Content.Omu.Server/Library/BookbinderSystem.cs
@@ -0,0 +1,414 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+using Content.Omu.Shared.Library;
+using Content.Server.Materials;
+using Content.Shared.Access.Systems;
+using Content.Shared.Administration.Logs;
+using Content.Shared.Database;
+using Content.Shared.Examine;
+using Content.Shared.Interaction;
+using Content.Shared.Materials;
+using Content.Shared.Paper;
+using Content.Shared.Popups;
+using Content.Shared.Power.EntitySystems;
+using Content.Shared.Tag;
+using Content.Shared.Verbs;
+using Robust.Shared.Audio.Systems;
+using Robust.Shared.Containers;
+using Robust.Shared.Prototypes;
+using Robust.Shared.Random;
+using Robust.Shared.Timing;
+
+namespace Content.Omu.Server.Library;
+
+/// <summary>
+///     The book binder: swipe an ID to be credited as the author, feed it a written sheet of paper and out comes
+///     a book. It also prints books from the library archive when a library console asks it to.
+///     Every book costs sheets of paper, kept in the binder's material storage.
+///     Ported from tgstation's /obj/machinery/bookbinder.
+/// </summary>
+public sealed class BookbinderSystem : EntitySystem
+{
+    [Dependency] private readonly IGameTiming _timing = default!;
+    [Dependency] private readonly IPrototypeManager _proto = default!;
+    [Dependency] private readonly IRobustRandom _random = default!;
+    [Dependency] private readonly ISharedAdminLogManager _adminLog = default!;
+    [Dependency] private readonly LibraryAccessSystem _libraryAccess = default!;
+    [Dependency] private readonly LibraryArchiveSystem _archive = default!;
+    [Dependency] private readonly MaterialStorageSystem _materialStorage = default!;
+    [Dependency] private readonly MetaDataSystem _meta = default!;
+    [Dependency] private readonly PaperSystem _paper = default!;
+    [Dependency] private readonly RandomArchiveBookSystem _bookFill = default!;
+    [Dependency] private readonly SharedAudioSystem _audio = default!;
+    [Dependency] private readonly SharedContainerSystem _container = default!;
+    [Dependency] private readonly SharedIdCardSystem _idCard = default!;
+    [Dependency] private readonly SharedMaterialStorageSystem _materials = default!;
+    [Dependency] private readonly SharedPopupSystem _popup = default!;
+    [Dependency] private readonly SharedPowerReceiverSystem _power = default!;
+    [Dependency] private readonly TagSystem _tag = default!;
+
+    private static readonly ProtoId<TagPrototype> BookTag = "Book";
+    private static readonly ProtoId<MaterialPrototype> PaperMaterial = "Paper";
+
+    private int? _sheetVolume;
+
+    /// <summary>
+    ///     How much material one sheet of paper is worth.
+    /// </summary>
+    private int SheetVolume => _sheetVolume ??= _materials.GetSheetVolume(_proto.Index(PaperMaterial));
+
+    public override void Initialize()
+    {
+        base.Initialize();
+
+        SubscribeLocalEvent<BookbinderComponent, ComponentInit>(OnInit);
+        SubscribeLocalEvent<BookbinderComponent, MapInitEvent>(OnMapInit);
+        SubscribeLocalEvent<BookbinderComponent, ExaminedEvent>(OnExamined);
+        SubscribeLocalEvent<BookbinderComponent, GetVerbsEvent<AlternativeVerb>>(OnGetVerbs);
+        SubscribeLocalEvent<BookbinderComponent, MaterialAmountChangedEvent>(OnSheetsChanged);
+        // Before the material storage, so paper pages and IDs are not mistaken for sheets of material.
+        SubscribeLocalEvent<BookbinderComponent, InteractUsingEvent>(OnInteractUsing,
+            before: [typeof(MaterialStorageSystem)]);
+    }
+
+    private void OnInit(EntityUid uid, BookbinderComponent component, ComponentInit args)
+    {
+        _container.EnsureContainer<ContainerSlot>(uid, BookbinderComponent.PaperContainerId);
+    }
+
+    private void OnMapInit(EntityUid uid, BookbinderComponent component, MapInitEvent args)
+    {
+        // Machines that were built by hand start without paper, the ones that spawned come with a little.
+        if (component.StartingSheets > 0)
+            _materials.TryChangeMaterialAmount(uid, PaperMaterial.Id, component.StartingSheets * SheetVolume);
+    }
+
+    private void OnExamined(EntityUid uid, BookbinderComponent component, ExaminedEvent args)
+    {
+        if (!args.IsInDetailsRange)
+            return;
+
+        var max = TryComp<MaterialStorageComponent>(uid, out var storage) && storage.StorageLimit is { } limit
+            ? limit / SheetVolume
+            : 0;
+
+        args.PushMarkup(Loc.GetString("bookbinder-examine-sheets",
+            ("sheets", GetSheets(uid)),
+            ("max", max),
+            ("bind", component.BindSheets),
+            ("print", component.PrintSheets)));
+    }
+
+    private void OnGetVerbs(EntityUid uid, BookbinderComponent component, GetVerbsEvent<AlternativeVerb> args)
+    {
+        if (!args.CanAccess || !args.CanInteract || args.Hands == null)
+            return;
+
+        var user = args.User;
+        args.Verbs.Add(new AlternativeVerb
+        {
+            Text = Loc.GetString("bookbinder-eject-verb"),
+            Disabled = GetSheets(uid) == 0,
+            Act = () => EjectSheets(uid, user),
+        });
+    }
+
+    /// <summary>
+    ///     Takes all the sheets of paper out of the binder.
+    /// </summary>
+    private void EjectSheets(EntityUid uid, EntityUid user)
+    {
+        if (!_libraryAccess.IsAllowed(uid, user))
+            return;
+
+        var sheets = GetSheets(uid);
+        if (sheets == 0)
+            return;
+
+        _materialStorage.EjectMaterial(uid, PaperMaterial.Id, coordinates: Transform(user).Coordinates);
+        _popup.PopupEntity(Loc.GetString("bookbinder-ejected", ("sheets", sheets)), uid, user);
+    }
+
+    private void OnSheetsChanged(EntityUid uid, BookbinderComponent component, ref MaterialAmountChangedEvent args)
+    {
+        RefreshConsoles();
+    }
+
+    /// <summary>
+    ///     Whole sheets of paper inside the binder.
+    /// </summary>
+    public int GetSheets(EntityUid uid)
+    {
+        return _materials.GetMaterialAmount(uid, PaperMaterial.Id) / SheetVolume;
+    }
+
+    private bool TryUseSheets(EntityUid uid, int sheets)
+    {
+        return _materials.TryChangeMaterialAmount(uid, PaperMaterial.Id, -sheets * SheetVolume);
+    }
+
+    public bool IsBusy(BookbinderComponent component)
+    {
+        return component.BindingEnd != null || component.PrintEnd != null;
+    }
+
+    /// <summary>
+    ///     Whether the binder could print an archive book right now.
+    /// </summary>
+    public bool CanPrint(EntityUid uid, BookbinderComponent component)
+    {
+        return _power.IsPowered(uid) && !IsBusy(component) && GetSheets(uid) >= component.PrintSheets;
+    }
+
+    private void OnInteractUsing(EntityUid uid, BookbinderComponent component, InteractUsingEvent args)
+    {
+        if (args.Handled)
+            return;
+
+        // Putting paper in is for librarians, other things (tools and so on) are not our business.
+        if (HasComp<MaterialComponent>(args.Used) && !HasComp<PaperComponent>(args.Used))
+        {
+            if (!_libraryAccess.IsAllowed(uid, args.User))
+                args.Handled = true;
+
+            // Otherwise the material storage takes the sheets.
+            return;
+        }
+
+        // Scanning an ID credits the person as the author of the next book.
+        if (_idCard.TryFindIdCard(args.Used, out var card))
+        {
+            args.Handled = true;
+
+            if (!_libraryAccess.IsAllowed(uid, args.User))
+                return;
+
+            var name = LibraryText.CleanLine(card.Comp.FullName, LibraryConstants.MaxAuthorLength);
+            if (string.IsNullOrEmpty(name))
+            {
+                _popup.PopupEntity(Loc.GetString("bookbinder-id-no-name"), uid, args.User);
+                return;
+            }
+
+            component.ScannedAuthor = name;
+            _audio.PlayPvs(component.ScanIdSound, uid);
+            _popup.PopupEntity(Loc.GetString("bookbinder-id-scanned", ("name", name)), uid, args.User);
+            return;
+        }
+
+        // Books are paper too, but they are not something that can be bound again.
+        if (!HasComp<PaperComponent>(args.Used) ||
+            HasComp<LibraryBookComponent>(args.Used) ||
+            _tag.HasTag(args.Used, BookTag))
+        {
+            return;
+        }
+
+        args.Handled = true;
+
+        if (!_libraryAccess.IsAllowed(uid, args.User))
+            return;
+
+        if (!_power.IsPowered(uid))
+        {
+            _popup.PopupEntity(Loc.GetString("bookbinder-no-power"), uid, args.User);
+            return;
+        }
+
+        if (IsBusy(component))
+        {
+            _popup.PopupEntity(Loc.GetString("bookbinder-busy"), uid, args.User);
+            return;
+        }
+
+        if (string.IsNullOrWhiteSpace(Comp<PaperComponent>(args.Used).Content))
+        {
+            _popup.PopupEntity(Loc.GetString("bookbinder-blank-paper"), uid, args.User);
+            return;
+        }
+
+        if (GetSheets(uid) < component.BindSheets)
+        {
+            _popup.PopupEntity(Loc.GetString("bookbinder-need-sheets", ("sheets", component.BindSheets)), uid, args.User);
+            return;
+        }
+
+        // Without an ID the first attempt only warns the user, trying again binds the book anonymously.
+        if (component.ScannedAuthor == null)
+        {
+            component.ScannedAuthor = Loc.GetString("bookbinder-unknown-author");
+            _popup.PopupEntity(Loc.GetString("bookbinder-no-id"), uid, args.User);
+            return;
+        }
+
+        var container = _container.EnsureContainer<ContainerSlot>(uid, BookbinderComponent.PaperContainerId);
+        if (!_container.Insert(args.Used, container))
+            return;
+
+        // The paper that was written on is bound together with the sheets from the binder's stock.
+        TryUseSheets(uid, component.BindSheets);
+
+        component.BindingEnd = _timing.CurTime + component.BindTime;
+        _audio.PlayPvs(component.BindSound, uid);
+        _popup.PopupEntity(Loc.GetString("bookbinder-loaded"), uid, args.User);
+        _popup.PopupEntity(Loc.GetString("bookbinder-warming-up"), uid);
+        RefreshConsoles();
+    }
+
+    /// <summary>
+    ///     Starts printing an archive book, asked for by a library console. The paper is used up right away.
+    ///     <paramref name="failure"/> is a locale id that says why the job could not be started.
+    /// </summary>
+    public bool TryStartPrint(
+        EntityUid uid,
+        BookbinderComponent component,
+        int archiveId,
+        EntityUid user,
+        out string failure,
+        LibraryCover? blankCover = null,
+        string blankTitle = "")
+    {
+        failure = string.Empty;
+
+        if (!_power.IsPowered(uid))
+        {
+            failure = "bookbinder-no-power";
+            return false;
+        }
+
+        if (IsBusy(component))
+        {
+            failure = "bookbinder-busy";
+            return false;
+        }
+
+        if (GetSheets(uid) < component.PrintSheets || !TryUseSheets(uid, component.PrintSheets))
+        {
+            failure = "library-console-binder-no-paper";
+            return false;
+        }
+
+        component.PrintEnd = _timing.CurTime + component.PrintTime;
+        component.PrintId = archiveId;
+        component.PrintUser = user;
+        component.PrintBlankCover = blankCover;
+        component.PrintBlankTitle = blankTitle;
+
+        _audio.PlayPvs(component.PrintSound, uid);
+        _popup.PopupEntity(Loc.GetString("bookbinder-warming-up"), uid);
+        RefreshConsoles();
+        return true;
+    }
+
+    public override void Update(float frameTime)
+    {
+        base.Update(frameTime);
+
+        var now = _timing.CurTime;
+        var query = EntityQueryEnumerator<BookbinderComponent>();
+        while (query.MoveNext(out var uid, out var component))
+        {
+            // Jobs are paused while the machine has no power.
+            if (!_power.IsPowered(uid))
+                continue;
+
+            if (component.BindingEnd is { } bindEnd && now >= bindEnd)
+                FinishBinding(uid, component);
+
+            if (component.PrintEnd is { } printEnd && now >= printEnd)
+                FinishPrint(uid, component);
+        }
+    }
+
+    private void FinishBinding(EntityUid uid, BookbinderComponent component)
+    {
+        component.BindingEnd = null;
+        var author = component.ScannedAuthor ?? string.Empty;
+        component.ScannedAuthor = null;
+
+        var container = _container.EnsureContainer<ContainerSlot>(uid, BookbinderComponent.PaperContainerId);
+        if (container.ContainedEntity is not { } paperUid)
+        {
+            RefreshConsoles();
+            return;
+        }
+
+        var content = TryComp<PaperComponent>(paperUid, out var paper) ? paper.Content : string.Empty;
+        QueueDel(paperUid);
+
+        var book = Spawn(component.BookPrototype, Transform(uid).Coordinates);
+        _meta.SetEntityName(book, Loc.GetString("bookbinder-print-job", ("number", _random.Next(100, 1000))));
+
+        var info = EnsureComp<LibraryBookComponent>(book);
+        info.Author = LibraryText.CleanLine(author, LibraryConstants.MaxAuthorLength);
+        info.PrintJob = true;
+        Dirty(book, info);
+
+        _paper.SetContent(book, content);
+
+        _popup.PopupEntity(Loc.GetString("bookbinder-finished"), uid);
+        RefreshConsoles();
+    }
+
+    private void FinishPrint(EntityUid uid, BookbinderComponent component)
+    {
+        component.PrintEnd = null;
+        var id = component.PrintId;
+        var user = component.PrintUser;
+        component.PrintUser = null;
+
+        // An empty book: no archive entry, no text. It only gets into the archive through scanning and an upload
+        // that an admin approves.
+        if (component.PrintBlankCover is { } blankCover)
+        {
+            component.PrintBlankCover = null;
+            var blankTitle = component.PrintBlankTitle;
+            component.PrintBlankTitle = string.Empty;
+
+            var blank = Spawn(component.BookPrototype, Transform(uid).Coordinates);
+            _meta.SetEntityName(blank, blankTitle.Length > 0 ? blankTitle : Loc.GetString("library-blank-book-name"));
+            EnsureComp<LibraryBookComponent>(blank);
+            _bookFill.ApplyCover(blank, blankCover);
+
+            _popup.PopupEntity(Loc.GetString("bookbinder-finished"), uid);
+            _adminLog.Add(LogType.Action, LogImpact.Low,
+                $"{ToPrettyString(user):player} printed a blank book from {ToPrettyString(uid)}");
+            RefreshConsoles();
+            return;
+        }
+
+        // The book may have been deleted by a moderator while it was printing, the paper is given back.
+        if (!_archive.TryGet(id, out var entry))
+        {
+            _materials.TryChangeMaterialAmount(uid, PaperMaterial.Id, component.PrintSheets * SheetVolume);
+            _popup.PopupEntity(Loc.GetString("library-console-print-error"), uid);
+            RefreshConsoles();
+            return;
+        }
+
+        // Guidebooks are real guidebook items, not paper books with text in them.
+        if (entry.SpawnPrototype != null && _proto.HasIndex<EntityPrototype>(entry.SpawnPrototype))
+        {
+            Spawn(entry.SpawnPrototype, Transform(uid).Coordinates);
+        }
+        else
+        {
+            var book = Spawn(component.BookPrototype, Transform(uid).Coordinates);
+            _bookFill.Fill(book, entry);
+        }
+
+        _popup.PopupEntity(Loc.GetString("bookbinder-finished"), uid);
+        _adminLog.Add(LogType.Action, LogImpact.Low,
+            $"{ToPrettyString(user):player} printed library book #{id} \"{entry.Title}\" by {entry.Author} from {ToPrettyString(uid)}");
+        RefreshConsoles();
+    }
+
+    private void RefreshConsoles()
+    {
+        var consoles = EntityQueryEnumerator<LibraryConsoleComponent>();
+        while (consoles.MoveNext(out var uid, out _))
+        {
+            RaiseLocalEvent(uid, new LibraryConsoleRefreshEvent());
+        }
+    }
+}
diff --git a/Content.Omu.Server/Library/LibraryAccessSystem.cs b/Content.Omu.Server/Library/LibraryAccessSystem.cs
new file mode 100644
index 000000000..432750dc5
--- /dev/null
+++ b/Content.Omu.Server/Library/LibraryAccessSystem.cs
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+using Content.Shared.Access.Systems;
+using Content.Shared.Popups;
+
+namespace Content.Omu.Server.Library;
+
+/// <summary>
+///     The library console, scanner and binder can only be used by people with a librarian or command ID.
+///     The allowed access is the <c>AccessReader</c> on each machine's prototype.
+/// </summary>
+public sealed class LibraryAccessSystem : EntitySystem
+{
+    [Dependency] private readonly AccessReaderSystem _access = default!;
+    [Dependency] private readonly SharedPopupSystem _popup = default!;
+
+    /// <summary>
+    ///     Whether <paramref name="user"/> carries an ID that is allowed to use <paramref name="machine"/>.
+    ///     Tells the user when they are not allowed, unless <paramref name="silent"/>.
+    /// </summary>
+    public bool IsAllowed(EntityUid machine, EntityUid user, bool silent = false)
+    {
+        if (_access.IsAllowed(user, machine))
+            return true;
+
+        if (!silent)
+            _popup.PopupEntity(Loc.GetString("library-access-denied"), machine, user);
+
+        return false;
+    }
+}
diff --git a/Content.Omu.Server/Library/LibraryArchiveSystem.cs b/Content.Omu.Server/Library/LibraryArchiveSystem.cs
new file mode 100644
index 000000000..c20d9c847
--- /dev/null
+++ b/Content.Omu.Server/Library/LibraryArchiveSystem.cs
@@ -0,0 +1,717 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using Content.Omu.Common.CCVar;
+using Content.Omu.Shared.Library;
+using Content.Shared.Paper;
+using Content.Shared.Tag;
+using Robust.Shared.Configuration;
+using Robust.Shared.ContentPack;
+using Robust.Shared.Prototypes;
+using Robust.Shared.Random;
+using Robust.Shared.Utility;
+
+namespace Content.Omu.Server.Library;
+
+/// <summary>
+///     The persistent library archive, the equivalent of the <c>library</c> table in tgstation.
+///     Every book is stored as its own small json file in the server's user data (<c>/library/</c>), so the
+///     archive survives round restarts and server restarts without needing a database migration.
+/// </summary>
+public sealed class LibraryArchiveSystem : EntitySystem
+{
+    [Dependency] private readonly IResourceManager _res = default!;
+    [Dependency] private readonly IConfigurationManager _cfg = default!;
+    [Dependency] private readonly IComponentFactory _factory = default!;
+    [Dependency] private readonly IPrototypeManager _proto = default!;
+    [Dependency] private readonly IRobustRandom _random = default!;
+    [Dependency] private readonly TagSystem _tag = default!;
+
+    private const string GuidebookParent = "BaseGuidebook";
+    private static readonly ProtoId<TagPrototype> GuidebookTag = "LibraryGuidebook";
+
+    private static readonly ResPath ArchiveDirectory = new("/library");
+
+    private static readonly JsonSerializerOptions JsonOptions = new()
+    {
+        WriteIndented = true,
+    };
+
+    private readonly Dictionary<int, LibraryArchiveEntry> _books = new();
+    private int _nextId = 1;
+
+    // Shuffle bag for random spawns, so books on a station are not repeated until all were used once.
+    private readonly List<int> _bag = new();
+    private List<LibraryArchiveEntry>? _fallback;
+
+    /// <summary>
+    ///     False when the archive directory could not be created or written to. Consoles show this as
+    ///     "connection to the archive severed", like tgstation does when the database is down.
+    /// </summary>
+    public bool Available { get; private set; }
+
+    /// <summary>
+    ///     Raised whenever a book is added, deleted or restored so open consoles can refresh.
+    /// </summary>
+    public event Action? ArchiveChanged;
+
+    public override void Initialize()
+    {
+        base.Initialize();
+
+        Load();
+        SeedMissing();
+    }
+
+    private void Load()
+    {
+        _books.Clear();
+        _nextId = 1;
+
+        try
+        {
+            _res.UserData.CreateDir(ArchiveDirectory);
+        }
+        catch (Exception e)
+        {
+            Log.Error($"Could not create the library archive directory, the library archive is unavailable: {e}");
+            Available = false;
+            return;
+        }
+
+        Available = true;
+
+        foreach (var name in _res.UserData.DirectoryEntries(ArchiveDirectory))
+        {
+            if (!name.EndsWith(".json", StringComparison.OrdinalIgnoreCase))
+                continue;
+
+            var path = ArchiveDirectory / name;
+            try
+            {
+                using var reader = new StreamReader(_res.UserData.OpenRead(path));
+                var entry = JsonSerializer.Deserialize<LibraryArchiveEntry>(reader.ReadToEnd(), JsonOptions);
+                if (entry == null || entry.Id <= 0)
+                {
+                    Log.Warning($"Ignoring invalid library archive file {path}");
+                    continue;
+                }
+
+                _books[entry.Id] = entry;
+                _nextId = Math.Max(_nextId, entry.Id + 1);
+            }
+            catch (Exception e)
+            {
+                Log.Warning($"Could not read library archive file {path}: {e.Message}");
+            }
+        }
+
+        Log.Info($"Library archive loaded with {_books.Count} books.");
+    }
+
+    /// <summary>
+    ///     Adds the premade books of the <see cref="LibrarySeedPrototype"/>s that the archive does not have
+    ///     yet. Books a moderator deleted stay in the archive (flagged deleted), so they are not added again.
+    /// </summary>
+    private void SeedMissing()
+    {
+        if (!Available)
+            return;
+
+        var known = new HashSet<string>(_books.Values
+            .Where(b => b.SeedId != null)
+            .Select(b => b.SeedId!));
+
+        var added = 0;
+        foreach (var seed in BuildSeedEntries())
+        {
+            if (seed.SeedId == null || !known.Add(seed.SeedId))
+                continue;
+
+            seed.Id = _nextId;
+            if (!Save(seed))
+                continue;
+
+            _nextId++;
+            _books[seed.Id] = seed;
+            added++;
+        }
+
+        if (added > 0)
+            Log.Info($"Added {added} premade books to the library archive.");
+    }
+
+    private List<LibraryArchiveEntry> BuildSeedEntries()
+    {
+        var result = new List<LibraryArchiveEntry>();
+        foreach (var seed in _proto.EnumeratePrototypes<LibrarySeedPrototype>())
+        {
+            var category = LibraryConstants.IsUploadCategory(seed.Category)
+                ? seed.Category
+                : LibraryConstants.DefaultUploadCategory;
+
+            foreach (var bookId in seed.Books)
+            {
+                if (!_proto.TryIndex(bookId, out var book) ||
+                    !book.TryGetComponent<PaperComponent>(out var paper, _factory))
+                {
+                    Log.Warning($"Library seed {seed.ID} lists {bookId}, which is not a paper book.");
+                    continue;
+                }
+
+                AddSeedEntry(result, $"book:{bookId}", book.Name, seed.Author, paper.Content, category);
+            }
+
+            foreach (var text in seed.Texts)
+            {
+                AddSeedEntry(result, $"text:{text.Text}", text.Title, text.Author ?? seed.Author, text.Text, category);
+            }
+        }
+
+        AddGuidebookEntries(result);
+        return result;
+    }
+
+    /// <summary>
+    ///     Every guidebook item (anything built on <c>BaseGuidebook</c>) gets an archive entry that prints the
+    ///     real guidebook, so the librarian can hand one out. They are not paper books and have no cover.
+    /// </summary>
+    private void AddGuidebookEntries(List<LibraryArchiveEntry> list)
+    {
+        foreach (var proto in _proto.EnumeratePrototypes<EntityPrototype>())
+        {
+            if (proto.Abstract || proto.ID == GuidebookParent)
+                continue;
+
+            // The tag is on BaseGuidebook, the parent chain is a second way to recognise them.
+            var guide = proto.TryGetComponent<TagComponent>(out var tags, _factory) &&
+                        _tag.HasTag(tags, GuidebookTag);
+            foreach (var parent in _proto.EnumerateParents<EntityPrototype>(proto.ID) ?? [])
+            {
+                if (parent.ID == GuidebookParent)
+                {
+                    guide = true;
+                    break;
+                }
+            }
+
+            if (!guide)
+                continue;
+
+            var description = LibraryText.CleanContent(proto.Description, LibraryConstants.MaxContentLength);
+            list.Add(new LibraryArchiveEntry
+            {
+                SeedId = $"guidebook:{proto.ID}",
+                SpawnPrototype = proto.ID,
+                Title = FitTitle(proto.Name),
+                Author = "Nanotrasen",
+                Content = string.IsNullOrWhiteSpace(description) ? proto.Name : description,
+                Category = "Reference",
+                UploaderUser = "library",
+                UploaderCharacter = "library",
+                UploadedUtc = DateTime.UtcNow,
+            });
+        }
+    }
+
+    private void AddSeedEntry(
+        List<LibraryArchiveEntry> list,
+        string seedId,
+        string title,
+        string author,
+        string contentOrKey,
+        string category)
+    {
+        // Premade books store a locale key as their content, resolved when they are map initialised.
+        var content = Loc.TryGetString(contentOrKey, out var text) ? text : contentOrKey;
+        var cleaned = LibraryText.CleanContent(content, LibraryConstants.MaxContentLength);
+        if (string.IsNullOrWhiteSpace(cleaned))
+            return;
+
+        list.Add(new LibraryArchiveEntry
+        {
+            SeedId = seedId,
+            Title = FitTitle(title),
+            Author = LibraryText.CleanLine(author, LibraryConstants.MaxAuthorLength),
+            Content = cleaned,
+            Category = category,
+            UploaderUser = "library",
+            UploaderCharacter = "library",
+            UploadedUtc = DateTime.UtcNow,
+        });
+    }
+
+    /// <summary>
+    ///     Shortens a long title at a word boundary instead of in the middle of a word.
+    /// </summary>
+    private static string FitTitle(string title)
+    {
+        var clean = LibraryText.CleanLine(title, 200);
+        if (clean.Length <= LibraryConstants.MaxTitleLength)
+            return clean;
+
+        var cut = clean.LastIndexOf(' ', LibraryConstants.MaxTitleLength - 1);
+        if (cut < LibraryConstants.MaxTitleLength / 2)
+            cut = LibraryConstants.MaxTitleLength - 1;
+
+        return clean.Substring(0, cut).TrimEnd() + "…";
+    }
+
+    /// <summary>
+    ///     The premade books that are put on the station's bookshelves every round: the archive's seed
+    ///     books that were not deleted, or the seed prototypes themselves when the archive is unavailable.
+    /// </summary>
+    public List<LibraryArchiveEntry> GetSeedBooks()
+    {
+        var books = _books.Values
+            .Where(b => b.SeedId != null && !b.Deleted && b.SpawnPrototype == null)
+            .OrderBy(b => b.Id)
+            .ToList();
+        if (books.Count > 0 || Available)
+            return books;
+
+        _fallback ??= BuildSeedEntries().Where(b => b.SpawnPrototype == null).ToList();
+        return _fallback;
+    }
+
+    /// <summary>
+    ///     Picks a book for a random book spawn: archive books that are not deleted and not in the
+    ///     <see cref="LibraryConstants.HiddenFromSpawnsCategory"/>, every book once before any repeats.
+    ///     Falls back to the premade seed books when the archive is unavailable or has nothing to offer.
+    /// </summary>
+    public bool TryPickRandom(out LibraryArchiveEntry entry)
+    {
+        for (var attempt = 0; attempt < 2; attempt++)
+        {
+            while (_bag.Count > 0)
+            {
+                var index = _random.Next(_bag.Count);
+                var id = _bag[index];
+                _bag[index] = _bag[^1];
+                _bag.RemoveAt(_bag.Count - 1);
+
+                if (_books.TryGetValue(id, out var found) && IsSpawnable(found))
+                {
+                    entry = found;
+                    return true;
+                }
+            }
+
+            foreach (var book in _books.Values)
+            {
+                if (IsSpawnable(book))
+                    _bag.Add(book.Id);
+            }
+
+            if (_bag.Count == 0)
+                break;
+        }
+
+        _fallback ??= BuildSeedEntries().Where(b => b.SpawnPrototype == null).ToList();
+        if (_fallback.Count > 0)
+        {
+            entry = _random.Pick(_fallback);
+            return true;
+        }
+
+        entry = default!;
+        return false;
+    }
+
+    private static bool IsSpawnable(LibraryArchiveEntry book)
+    {
+        return !book.Deleted && !book.Pending && book.SpawnPrototype == null && book.Category != LibraryConstants.HiddenFromSpawnsCategory;
+    }
+
+    private bool Save(LibraryArchiveEntry entry)
+    {
+        if (!Available)
+            return false;
+
+        try
+        {
+            var json = JsonSerializer.Serialize(entry, JsonOptions);
+            using var writer = _res.UserData.OpenWriteText(ArchiveDirectory / $"{entry.Id}.json");
+            writer.Write(json);
+            return true;
+        }
+        catch (Exception e)
+        {
+            Log.Error($"Could not write library book {entry.Id} to disk: {e}");
+            return false;
+        }
+    }
+
+    /// <summary>
+    ///     Number of books that are not deleted.
+    /// </summary>
+    public int BookCount => _books.Values.Count(b => !b.Deleted && !b.Pending);
+
+    /// <summary>
+    ///     Number of uploaded books waiting for an admin to review them.
+    /// </summary>
+    public int PendingCount => _books.Values.Count(b => b.Pending && !b.Deleted);
+
+    /// <summary>
+    ///     Searches the archive, newest books first. Mirrors the query of the tgstation library console:
+    ///     substring matches on title and author, an exact category (or <see cref="LibraryConstants.AnyCategory"/>)
+    ///     and an optional id.
+    /// </summary>
+    /// <param name="page">Zero based page, clamped to the available pages.</param>
+    /// <param name="pageCount">Zero based index of the last page.</param>
+    public List<LibraryBookSummary> Search(
+        string title,
+        string author,
+        string category,
+        int? id,
+        ref int page,
+        out int pageCount)
+    {
+        var matches = _books.Values
+            .Where(b => !b.Deleted && !b.Pending)
+            .Where(b => id == null || b.Id == id)
+            .Where(b => b.Title.Contains(title, StringComparison.OrdinalIgnoreCase))
+            .Where(b => b.Author.Contains(author, StringComparison.OrdinalIgnoreCase))
+            .Where(b => category == LibraryConstants.AnyCategory || b.Category == category)
+            .OrderByDescending(b => b.Id)
+            .ToList();
+
+        pageCount = Math.Max(matches.Count - 1, 0) / LibraryConstants.BooksPerPage;
+        page = Math.Clamp(page, 0, pageCount);
+
+        return matches
+            .Skip(page * LibraryConstants.BooksPerPage)
+            .Take(LibraryConstants.BooksPerPage)
+            .Select(b => new LibraryBookSummary(b.Id, b.Title, b.Author, b.Category))
+            .ToList();
+    }
+
+    /// <summary>
+    ///     A fingerprint of a book's text that ignores case, spacing and punctuation, so a copy of a book
+    ///     with a few changed symbols still counts as the same text. Empty when the text has no letters or digits.
+    /// </summary>
+    public static string MakeContentKey(string content)
+    {
+        var builder = new StringBuilder(content.Length);
+        foreach (var c in content)
+        {
+            if (char.IsLetterOrDigit(c))
+                builder.Append(char.ToLowerInvariant(c));
+        }
+
+        if (builder.Length == 0)
+            return string.Empty;
+
+        return Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(builder.ToString())));
+    }
+
+    /// <summary>
+    ///     Looks for an archived book (not deleted) that has the same text, whatever its title or author is.
+    ///     Books waiting for review count too, but their id is not given out, so <paramref name="pending"/>
+    ///     tells the caller that the match is still under review.
+    /// </summary>
+    public bool TryFindDuplicate(string content, out int id)
+    {
+        return TryFindDuplicate(content, out id, out _);
+    }
+
+    public bool TryFindDuplicate(string content, out int id, out bool pending)
+    {
+        var key = MakeContentKey(content);
+        if (key.Length > 0)
+        {
+            foreach (var book in _books.Values)
+            {
+                if (!book.Deleted && book.ContentKey == key)
+                {
+                    id = book.Id;
+                    pending = book.Pending;
+                    return true;
+                }
+            }
+        }
+
+        id = 0;
+        pending = false;
+        return false;
+    }
+
+    /// <summary>
+    ///     Gets a premade book by its seed id (a guidebook, for example), if it was not deleted.
+    /// </summary>
+    public bool TryGetBySeed(string seedId, out LibraryArchiveEntry entry)
+    {
+        foreach (var book in _books.Values)
+        {
+            if (book.SeedId == seedId && !book.Deleted && !book.Pending)
+            {
+                entry = book;
+                return true;
+            }
+        }
+
+        entry = default!;
+        return false;
+    }
+
+    /// <summary>
+    ///     Gets a book that has not been deleted.
+    /// </summary>
+    public bool TryGet(int id, out LibraryArchiveEntry entry)
+    {
+        if (_books.TryGetValue(id, out var found) && !found.Deleted && !found.Pending)
+        {
+            entry = found;
+            return true;
+        }
+
+        entry = default!;
+        return false;
+    }
+
+    /// <summary>
+    ///     Adds a book to the archive. Returns the new id, or null when the archive is full, unavailable or
+    ///     the book could not be written. Books with <paramref name="pending"/> set are only queued for admin
+    ///     review and stay invisible to players until <see cref="Approve"/> is called.
+    /// </summary>
+    public int? Add(
+        LibraryBookData book,
+        string category,
+        string uploaderUser,
+        string uploaderCharacter,
+        LibraryCover? cover = null,
+        bool pending = false)
+    {
+        if (!Available)
+            return null;
+
+        if (TryFindDuplicate(book.Content, out _))
+            return null;
+
+        var max = _cfg.GetCVar(OmuCVars.LibraryMaxBooks);
+        if (max > 0 && BookCount + (pending ? PendingCount : 0) >= max)
+            return null;
+
+        if (pending && PendingCount >= LibraryConstants.MaxPendingBooks)
+            return null;
+
+        var entry = new LibraryArchiveEntry
+        {
+            Id = _nextId,
+            Title = book.Title,
+            Author = book.Author,
+            Content = book.Content,
+            Category = category,
+            Cover = cover == null ? null : LibraryCovers.Sanitize(cover.Value),
+            UploaderUser = uploaderUser,
+            UploaderCharacter = uploaderCharacter,
+            UploadedUtc = DateTime.UtcNow,
+            Pending = pending,
+        };
+
+        if (!Save(entry))
+            return null;
+
+        _nextId++;
+        _books[entry.Id] = entry;
+        ArchiveChanged?.Invoke();
+        return entry.Id;
+    }
+
+    /// <summary>
+    ///     Soft deletes a book, like the <c>deleted</c> column in tgstation. The file stays on disk so a
+    ///     moderator can restore it.
+    /// </summary>
+    public bool Delete(int id, string deletedBy)
+    {
+        if (!_books.TryGetValue(id, out var entry) || entry.Deleted || entry.Pending)
+            return false;
+
+        entry.Deleted = true;
+        entry.DeletedBy = deletedBy;
+        if (!Save(entry))
+        {
+            entry.Deleted = false;
+            entry.DeletedBy = null;
+            return false;
+        }
+
+        ArchiveChanged?.Invoke();
+        return true;
+    }
+
+    public bool Restore(int id)
+    {
+        if (!_books.TryGetValue(id, out var entry) || !entry.Deleted)
+            return false;
+
+        entry.Deleted = false;
+        var deletedBy = entry.DeletedBy;
+        entry.DeletedBy = null;
+        if (!Save(entry))
+        {
+            entry.Deleted = true;
+            entry.DeletedBy = deletedBy;
+            return false;
+        }
+
+        ArchiveChanged?.Invoke();
+        return true;
+    }
+
+    /// <summary>
+    ///     The books waiting for review, oldest first.
+    /// </summary>
+    public List<LibraryArchiveEntry> GetPending()
+    {
+        return _books.Values.Where(b => b.Pending && !b.Deleted).OrderBy(b => b.Id).ToList();
+    }
+
+    public bool TryGetPending(int id, out LibraryArchiveEntry entry)
+    {
+        if (_books.TryGetValue(id, out var found) && found.Pending && !found.Deleted)
+        {
+            entry = found;
+            return true;
+        }
+
+        entry = default!;
+        return false;
+    }
+
+    /// <summary>
+    ///     Archive books (not pending, not deleted) for the admin tab, newest first. The filter matches the
+    ///     id, title, author or the uploader's username.
+    /// </summary>
+    public List<LibraryArchiveEntry> SearchAdmin(string filter, ref int page, out int pageCount)
+    {
+        var matches = _books.Values
+            .Where(b => !b.Deleted && !b.Pending)
+            .Where(b => filter.Length == 0 ||
+                        b.Id.ToString() == filter ||
+                        b.Title.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
+                        b.Author.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
+                        b.UploaderUser.Contains(filter, StringComparison.OrdinalIgnoreCase))
+            .OrderByDescending(b => b.Id)
+            .ToList();
+
+        pageCount = Math.Max(matches.Count - 1, 0) / LibraryConstants.BooksPerPage;
+        page = Math.Clamp(page, 0, pageCount);
+        return matches.Skip(page * LibraryConstants.BooksPerPage).Take(LibraryConstants.BooksPerPage).ToList();
+    }
+
+    /// <summary>
+    ///     Accepts a pending book, which makes it visible in the archive.
+    /// </summary>
+    public bool Approve(int id)
+    {
+        if (!TryGetPending(id, out var entry))
+            return false;
+
+        var max = _cfg.GetCVar(OmuCVars.LibraryMaxBooks);
+        if (max > 0 && BookCount >= max)
+            return false;
+
+        entry.Pending = false;
+        if (!Save(entry))
+        {
+            entry.Pending = true;
+            return false;
+        }
+
+        ArchiveChanged?.Invoke();
+        return true;
+    }
+
+    /// <summary>
+    ///     Declines a pending book and deletes it for good. If the file cannot be removed the book is hidden
+    ///     (soft deleted) instead, so players never see it either way.
+    /// </summary>
+    public bool Decline(int id, string declinedBy)
+    {
+        if (!TryGetPending(id, out var entry))
+            return false;
+
+        try
+        {
+            _res.UserData.Delete(ArchiveDirectory / $"{id}.json");
+        }
+        catch (Exception e)
+        {
+            Log.Error($"Could not delete declined library book {id}, hiding it instead: {e}");
+            entry.Pending = false;
+            entry.Deleted = true;
+            entry.DeletedBy = declinedBy;
+            Save(entry);
+        }
+
+        _books.Remove(id);
+        ArchiveChanged?.Invoke();
+        return true;
+    }
+
+    /// <summary>
+    ///     Every book, including deleted ones, newest first. For admin tooling.
+    /// </summary>
+    public IEnumerable<LibraryArchiveEntry> All()
+    {
+        return _books.Values.OrderByDescending(b => b.Id);
+    }
+
+    public bool TryGetAny(int id, out LibraryArchiveEntry entry)
+    {
+        return _books.TryGetValue(id, out entry!);
+    }
+}
+
+/// <summary>
+///     A book as stored on disk.
+/// </summary>
+public sealed class LibraryArchiveEntry
+{
+    public int Id { get; set; }
+    public string Title { get; set; } = string.Empty;
+    public string Author { get; set; } = string.Empty;
+    public string Content { get; set; } = string.Empty;
+
+    private string? _contentKey;
+
+    /// <summary>Fingerprint of <see cref="Content"/>, see <see cref="LibraryArchiveSystem.MakeContentKey"/>.</summary>
+    [System.Text.Json.Serialization.JsonIgnore]
+    public string ContentKey => _contentKey ??= LibraryArchiveSystem.MakeContentKey(Content);
+
+    public string Category { get; set; } = LibraryConstants.DefaultUploadCategory;
+
+    /// <summary>Username (ckey) of the player that uploaded the book.</summary>
+    public string UploaderUser { get; set; } = string.Empty;
+
+    /// <summary>Name of the character that uploaded the book.</summary>
+    public string UploaderCharacter { get; set; } = string.Empty;
+
+    public DateTime UploadedUtc { get; set; }
+    public bool Deleted { get; set; }
+
+    /// <summary>True while an admin has not accepted the book yet. Pending books are hidden from players.</summary>
+    public bool Pending { get; set; }
+
+    /// <summary>
+    ///     How the book looks. Books without one (premade books, books uploaded before covers existed)
+    ///     use <see cref="LibraryCovers.Default"/> of their id.
+    /// </summary>
+    public LibraryCover? Cover { get; set; }
+
+    /// <summary>Set for premade books copied from a <see cref="LibrarySeedPrototype"/>.</summary>
+    public string? SeedId { get; set; }
+
+    /// <summary>
+    ///     When set, printing this entry spawns that item (a guidebook) instead of a paper book with text.
+    ///     Such entries never spawn as random books or on shelves.
+    /// </summary>
+    public string? SpawnPrototype { get; set; }
+
+    public string? DeletedBy { get; set; }
+}
